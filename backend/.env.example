# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# PostgreSQL connection (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://builder:builder_dev_password@localhost:5432/builder_platform?schema=public"

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Media storage (Phase 4)
CLOUDINARY_CLOUD_NAME= 
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
